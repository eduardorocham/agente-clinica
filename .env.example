# Gemini (Google AI Studio)
GEMINI_API_KEY=...
GEMINI_MODEL=gemma-4-26b-a4b-it

# Fuso horário da clínica (agenda, horários e data atual no prompt)
FUSO_HORARIO=America/Sao_Paulo

# Agenda: google | memoria
# memoria: agenda fictícia em memória, útil para testar sem credenciais do Google
CALENDARIO_BACKEND=google

# Google Calendar (obrigatório quando CALENDARIO_BACKEND=google)
# ID da agenda da clínica (Configurações da agenda > Integrar agenda > ID da agenda)
GOOGLE_CALENDAR_ID=primary
# JSON de uma service account OU de um cliente OAuth "App para computador"
GOOGLE_CREDENTIALS_FILE=credentials.json
# Onde o token OAuth é salvo após o primeiro login (não usado com service account)
GOOGLE_TOKEN_FILE=token.json

# Tracing das execuções do agente no LangSmith (opcional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=agente-clinica

# WhatsApp Cloud API (Meta) — canal de atendimento
# developers.facebook.com > seu app > WhatsApp > Configuração da API
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Texto livre escolhido por você; informe o mesmo valor ao configurar o webhook na Meta
WHATSAPP_VERIFY_TOKEN=troque-este-valor
# Configurações do app > Básico > Chave secreta do app (valida a assinatura do webhook)
WHATSAPP_APP_SECRET=...
WHATSAPP_API_VERSION=v23.0
# Minutos sem mensagem até a conversa recomeçar do zero
WHATSAPP_SESSAO_MINUTOS=120
